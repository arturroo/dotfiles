# Git Ignore - Personal Dotfiles & Engineering Standards
# Zero-Secret & Zero-Pollution Policy
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.csr
*credentials*.json
*service_account*.json
*sa-*.json

# --- Terraform State & Secrets ---
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.terraform.lock.hcl

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Operating System & Editor Scratch Files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# --- Logs & Run Notes ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
run_notes.txt
**/run_notes.txt
